#!/usr/bin/env bash
set -euo pipefail
cd "${MISE_PROJECT_ROOT:-$(dirname "$0")/..}"

command="${1:-}"
shift || true
case "$command" in
  list)
    for case_file in evals/cases/*.yaml; do
      [ -f "$case_file" ] || continue
      basename "$case_file" .yaml
    done
    ;;
  run)
    if [ "$#" -ne 1 ] || [[ ! "$1" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] ||
       [ ! -f "evals/cases/$1.yaml" ] || [ ! -f "evals/cases/$1.json" ]; then
      echo 'Usage: mise run eval:run <name> (see eval:list)' >&2
      exit 2
    fi
    name="$1"
    ;;
  all)
    if [ "$#" -ne 0 ]; then
      echo 'Usage: mise run eval:all' >&2
      exit 2
    fi
    name=all
    ;;
  *)
    echo 'Use mise run eval:list, eval:run <name>, or eval:all' >&2
    exit 2
    ;;
esac

if [ "$command" = list ]; then exit 0; fi
mkdir -p .tmp/evals/results
result_dir=$(mktemp -d ".tmp/evals/results/${name}-XXXXXX")
echo "Promptfoo results: $result_dir/promptfoo.json"
args=(eval -c evals/promptfooconfig.yaml -o "$result_dir/promptfoo.json" --no-cache --no-share)
if [ "$command" = run ]; then args+=(--filter-pattern "^${name}$"); fi
exec ./node_modules/.bin/promptfoo "${args[@]}"
