{
  "name": "pizen",
  "private": true,
  "description": "Monorepo root for the @cloudvoyant scope",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.4.0",
  "scripts": {
    "build": "bun run --filter pizen build",
    "test": "bun run --filter pizen test",
    "lint": "bun run --filter pizen lint",
    "lint:fix": "bun run --filter pizen lint:fix",
    "format": "bun run --filter pizen format",
    "format:check": "bun run --filter pizen format:check"
  }
}
