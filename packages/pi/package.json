{
  "name": "@difflab/pi",
  "version": "0.4.0",
  "description": "Tools and skills for the pi coding agent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/difflab-io/diffpi.git",
    "directory": "packages/pi"
  },
  "homepage": "https://github.com/difflab-io/diffpi#readme",
  "bugs": {
    "url": "https://github.com/difflab-io/diffpi/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "diffpi": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./dist/tools/index.js"
    }
  },
  "files": [
    "agents/",
    "dist/",
    "skills/",
    "templates/"
  ],
  "pi": {
    "extensions": [
      "./dist/extensions/index.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "keywords": [
    "pi-package",
    "pi",
    "developer-tools"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@juicesharp/rpiv-ask-user-question": "^2.10.1",
    "commander": "^14.0.0",
    "mdast-builder": "1.1.1",
    "pi-mcp-adapter": "^2.33.0",
    "remark-stringify": "11.0.0",
    "unified": "11.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@semantic-release/changelog": "^6.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.0",
    "@semantic-release/github": "^10.0.0",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@types/bun": "^1.3.10",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "semantic-release": "^24.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  }
}
